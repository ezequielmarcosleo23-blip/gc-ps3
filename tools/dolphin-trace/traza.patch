+// gc-ps3: con GCPS3_TRIANGULOS=archivo, cada triángulo que llega al
+// rasterizador (recortado, en la pantalla): por vértice x, y, z de la
+// pantalla, w proyectado, los 2 colores y las coordenadas de textura, con los
+// bits de cada float (NaN como 7fc00000). gc-ps3 escribe lo mismo.
+namespace GCPS3Triangulos
+{
+static FILE* File()
+{
+  static bool init = false;
+  static FILE* file = nullptr;
+  if (!init)
+  {
+    init = true;
+    if (const char* path = std::getenv("GCPS3_TRIANGULOS"))
+    {
+      file = std::fopen(path, "w");
+      if (file)
+        std::fprintf(file, "# gc-ps3 triangulos v1\n");
+    }
+  }
+  return file;
+}
+
+static u32 Bits(float f)
+{
+  if (f != f)
+    return 0x7fc00000u;
+  u32 u;
+  std::memcpy(&u, &f, sizeof(u));
+  return u;
+}
+
+static void Write(const OutputVertexData* const v[3])
+{
+  FILE* f = File();
+  if (!f)
+    return;
+  const u32 ntex = bpmem.genMode.numtexgens;
+  std::fprintf(f, "t%u", ntex);
+  for (int k = 0; k < 3; k++)
+  {
+    std::fprintf(f, " v %08x %08x %08x %08x", Bits(v[k]->screenPosition.x),
+                 Bits(v[k]->screenPosition.y), Bits(v[k]->screenPosition.z),
+                 Bits(v[k]->projectedPosition.w));
+    for (const auto& c : v[k]->color)
+      std::fprintf(f, " %02x%02x%02x%02x", c[0], c[1], c[2], c[3]);
+    for (u32 i = 0; i < ntex && i < 8; i++)
+      std::fprintf(f, " %08x %08x %08x", Bits(v[k]->texCoords[i].x), Bits(v[k]->texCoords[i].y),
+                   Bits(v[k]->texCoords[i].z));
+  }
+  std::fprintf(f, "\n");
+}
+}  // namespace GCPS3Triangulos
+
+void GCPS3FlushTriangles()
+{
+  if (FILE* f = GCPS3Triangulos::File())
+    std::fflush(f);
+}
