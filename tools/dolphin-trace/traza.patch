+// gc-ps3: con GCPS3_VERTICES=archivo, cada vértice que transforma TransformUnit
+// (la primera vez que aparece en el lote, es decir, en el orden de carga) se
+// anota en texto: posición en la vista, proyectada, las 3 normales, los 2
+// colores y las coordenadas de textura que genera XF, con los bits de cada
+// float. gc-ps3 escribe lo mismo (src/gx, docs/traza-dolphin.md).
+namespace GCPS3Vertices
+{
+static FILE* File()
+{
+  static bool init = false;
+  static FILE* file = nullptr;
+  if (!init)
+  {
+    init = true;
+    if (const char* path = std::getenv("GCPS3_VERTICES"))
+    {
+      file = std::fopen(path, "w");
+      if (file)
+        std::fprintf(file, "# gc-ps3 vertices v1\n");
+    }
+  }
+  return file;
+}
+
+// Un NaN se anota siempre como 7fc00000: su signo y su carga dependen de la
+// máquina (0/0 da ffc00000 en x86 y 7fc00000 en PowerPC)
+static u32 Bits(float f)
+{
+  if (f != f)
+    return 0x7fc00000u;
+  u32 u;
+  std::memcpy(&u, &f, sizeof(u));
+  return u;
+}
+
+static void Write(FILE* f, const OutputVertexData* v, u32 ntex)
+{
+  std::fprintf(f, "v %08x %08x %08x p %08x %08x %08x %08x n", Bits(v->mvPosition.x),
+               Bits(v->mvPosition.y), Bits(v->mvPosition.z), Bits(v->projectedPosition.x),
+               Bits(v->projectedPosition.y), Bits(v->projectedPosition.z),
+               Bits(v->projectedPosition.w));
+  for (const auto& n : v->normal)
+    std::fprintf(f, " %08x %08x %08x", Bits(n.x), Bits(n.y), Bits(n.z));
+  std::fprintf(f, " c");
+  for (const auto& c : v->color)
+    std::fprintf(f, " %02x%02x%02x%02x", c[0], c[1], c[2], c[3]);
+  std::fprintf(f, " t%u", ntex);
+  for (u32 k = 0; k < ntex; k++)
+  {
+    std::fprintf(f, " %08x %08x %08x", Bits(v->texCoords[k].x), Bits(v->texCoords[k].y),
+                 Bits(v->texCoords[k].z));
+  }
+  std::fprintf(f, "\n");
+}
+}  // namespace GCPS3Vertices
