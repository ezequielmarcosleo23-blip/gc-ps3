+namespace GCPS3Copias
+{
+u8* (*efb_pixel)(u16 x, u16 y, bool depth) = nullptr;
+
+static FILE* File()
+{
+  static bool init = false;
+  static FILE* file = nullptr;
+  if (!init)
+  {
+    init = true;
+    if (const char* path = std::getenv("GCPS3_COPIAS"))
+    {
+      file = std::fopen(path, "w");
+      if (file)
+        std::fprintf(file, "# gc-ps3 copias v1\n");
+    }
+  }
+  return file;
+}
+
+// CRC-32 de zlib (polinomio 0xEDB88320), el de gc_crc32
+static u32 Crc(u32 crc, const u8* p, size_t n)
+{
+  static u32 table[256];
+  if (!table[1])
+  {
+    for (u32 i = 0; i < 256; i++)
+    {
+      u32 c = i;
+      for (int k = 0; k < 8; k++)
+        c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+      table[i] = c;
+    }
+  }
+  crc = ~crc;
+  while (n--)
+    crc = table[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+  return ~crc;
+}
+
+// El EFB de [x0, x1) × [y0, y1): los 3 bytes de color de cada píxel, fila por
+// fila, y después los 3 de Z
+static void EfbCrc(int x0, int y0, int x1, int y1, u32* color, u32* depth)
+{
+  *color = *depth = 0;
+  if (!efb_pixel)
+    return;
+  for (int d = 0; d < 2; d++)
+  {
+    u32 crc = 0;
+    for (int y = y0; y < y1; y++)
+      for (int x = x0; x < x1; x++)
+        crc = Crc(crc, efb_pixel(u16(x), u16(y), d != 0), 3);
+    (d ? *depth : *color) = crc;
+  }
+}
+
+static void Copy(const MathUtil::Rectangle<s32>& raw, int x0, int y0, int x1, int y1, u32 dest,
+                 u32 stride, u32 bytes_per_row, u32 rows, bool valid)
+{
+  FILE* f = File();
+  if (!f)
+    return;
+  std::fprintf(f, "c %u %06x src %d %d %d %d dst %08x %u", unsigned(bpmem.zcontrol.pixel_format.Value()),
+               bpmem.triggerEFBCopy.Hex & 0xFFFFFF, raw.left, raw.top, raw.GetWidth(),
+               raw.GetHeight(), dest, stride);
+  if (!valid)
+  {
+    std::fprintf(f, " fuera\n");
+    return;
+  }
+  u32 color, depth;
+  EfbCrc(x0, y0, x1, y1, &color, &depth);
+  std::fprintf(f, " efb %08x %08x", color, depth);
+  if (rows == 0)
+  {
+    std::fprintf(f, " ram 0 00000000\n");
+    return;
+  }
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u32 crc = 0;
+  for (u32 r = 0; r < rows; r++)
+  {
+    const u8* p = memory.GetPointerForRange(dest + r * stride, bytes_per_row);
+    if (p)
+      crc = Crc(crc, p, bytes_per_row);
+  }
+  std::fprintf(f, " ram %u %08x\n", bytes_per_row * rows, crc);
+}
+
+void Fin()
+{
+  FILE* f = File();
+  if (!f)
+    return;
+  u32 color, depth;
+  EfbCrc(0, 0, EFB_WIDTH, EFB_HEIGHT, &color, &depth);
+  std::fprintf(f, "efb %08x %08x\n", color, depth);
+  std::fclose(f);
+}
+}  // namespace GCPS3Copias
